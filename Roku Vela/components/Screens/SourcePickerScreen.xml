<?xml version="1.0" encoding="utf-8" ?>
<component name="SourcePickerScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/Screens/SourcePickerScreen.brs" />
    <interface>
        <field id="mediaItem" type="assocarray" />
        <field id="season" type="integer" />
        <field id="episode" type="integer" />
        <field id="autoplay" type="boolean" />
    </interface>
    <children>
        <Label id="header" translation="[40,30]" color="0xFFFFFFff" font="font:LargeBoldSystemFont" />
        <Label id="status" translation="[40,90]" color="0xAAAAAAff" width="1600" wrap="true" font="font:SmallSystemFont" />
        <BusySpinner id="loading" translation="[820,440]" control="start" />
        <LabelList
            id="sourceList"
            translation="[40,150]"
            itemSize="[1600,72]"
            color="0xCCCCCCff"
            focusedColor="0x3B82F6ff"
            drawFocusFeedback="true"
            font="font:SmallSystemFont" />
    </children>
</component>
