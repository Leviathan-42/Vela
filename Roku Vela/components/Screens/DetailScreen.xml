<?xml version="1.0" encoding="utf-8" ?>
<component name="DetailScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/Screens/DetailScreen.brs" />
    <interface>
        <field id="mediaItem" type="assocarray" />
    </interface>
    <children>
        <Poster id="backdrop" width="1680" height="1080" loadSync="false" />
        <Rectangle width="1680" height="1080" color="0x0a0a0acc" translation="[0,0]" />
        <Poster id="poster" translation="[40,160]" width="280" height="420" />
        <Label id="titleLabel" translation="[360,180]" width="1280" height="80" color="0xFFFFFFff" wrap="false" font="font:LargeBoldSystemFont" />
        <Label id="metaLabel" translation="[360,270]" width="1280" height="36" color="0xAAAAAAff" font="font:SmallSystemFont" />
        <Label id="overviewLabel" translation="[360,320]" width="1280" height="220" color="0xCCCCCCff" wrap="true" numLines="6" font="font:SmallSystemFont" />
        <ButtonGroup id="buttonGroup" translation="[360,560]" layoutDirection="horiz" itemSpacings="[20]">
            <Button id="playButton" text="Play" minWidth="200" />
            <Button id="sourceButton" text="Sources" minWidth="200" />
            <Button id="watchlistButton" text="+ Watchlist" minWidth="240" />
        </ButtonGroup>
        <LabelList
            id="seasonList"
            translation="[360,680]"
            itemSize="[160,60]"
            color="0xCCCCCCff"
            focusedColor="0x3B82F6ff"
            drawFocusFeedback="true"
            font="font:SmallSystemFont"
            visible="false" />
        <LabelList
            id="episodeList"
            translation="[540,680]"
            itemSize="[1080,60]"
            color="0xCCCCCCff"
            focusedColor="0x3B82F6ff"
            drawFocusFeedback="true"
            font="font:SmallSystemFont"
            visible="false" />
    </children>
</component>
