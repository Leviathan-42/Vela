<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <script type="text/brightscript" uri="pkg:/components/Screens/PlayerScreen.brs" />
    <interface>
        <field id="manifestUrl" type="string" />
        <field id="title" type="string" />
        <field id="mediaId" type="string" />
        <field id="mediaType" type="string" />
        <field id="season" type="integer" />
        <field id="episode" type="integer" />
    </interface>
    <children>
        <Rectangle width="1920" height="1080" color="0x000000ff" translation="[-240,0]" />
        <Video id="video" translation="[-240,0]" width="1920" height="1080" loop="false" notificationInterval="5" />
    </children>
</component>
