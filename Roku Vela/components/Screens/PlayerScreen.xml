<?xml version="1.0" encoding="utf-8" ?>
<component name="PlayerScreen" extends="Group">
    <script type="text/brightscript" uri="pkg:/components/Screens/PlayerScreen.brs" />
    <interface>
        <field id="manifestUrl" type="string" />
        <field id="title" type="string" />
        <field id="resumePosition" type="integer" />
    </interface>
    <children>
        <Video
            id="video"
            translation="[0,0]"
            width="1920"
            height="1080"
            loop="false"
            notificationInterval="5" />
    </children>
</component>
